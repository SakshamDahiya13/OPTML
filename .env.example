# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored on purpose — never commit it.
#
# Where to find these:
#   supabase.com/dashboard -> your project -> Project Settings -> API
#
# Note: EXPO_PUBLIC_* values are inlined into the JS bundle at build time,
# so after changing them you must restart with `npx expo start -c`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
